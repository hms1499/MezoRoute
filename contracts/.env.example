# Copy to .env (git-ignored) and fill in. Use a TESTNET-ONLY key that holds no real funds.

# Deployer / smoke-test wallet: needs test BTC for gas (https://faucet.test.mezo.org)
# and at least AMOUNT MUSD for the smoke test (borrow or swap in https://testnet.mezo.org).
PRIVATE_KEY=

# Address that receives the execution fee.
FEE_RECIPIENT=
FEE_BPS=10

# Filled after deployment.
EXECUTOR=

# Smoke test options.
AMOUNT=20000000000000000000
# Set to 1 only if the PRIVATE_KEY wallet owns an open Trove with borrowing headroom.
BORROW=0
